# CaM Cockpit — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env — o pré-commit hook bloqueia e está no .gitignore.

# Banco de dados (PostgreSQL 16 + TimescaleDB via Docker)
DATABASE_URL=postgresql+psycopg://cam:cam@localhost:5434/cam_db

# Telegram Bot (opcional — cockpit funciona sem, mas alertas críticos não serão enviados)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API (opcional — Ollama local é o default para IA auditora)
ANTHROPIC_API_KEY=

# Ollama (default para IA auditora — dados sensíveis nunca saem do ambiente local)
OLLAMA_BASE_URL=http://localhost:11434

# Diretório do journal duplo JSONL (fallback Art. 19º)
CAM_JOURNAL_DIR=~/.cam/journal

# ===========================================================================
# Camada de integração com broker (SPEC v0.2 — coexistência Profit/MT5)
# ===========================================================================
# Apenas UMA pode estar "true" por vez (mutex R21.03).
PROFIT_INTEGRATION_ENABLED=false
MT5_INTEGRATION_ENABLED=true

# Bridge MT5 ZeroMQ (apenas se MT5_INTEGRATION_ENABLED=true)
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PUB_PORT=5556
MT5_BRIDGE_REQ_PORT=5557
# Conecta a bridge no startup do backend (produção Windows com MT5 aberto).
MT5_BRIDGE_AUTOCONNECT=false

# Path do MT5 dentro do Wine (Linux) ou Windows VPS
MT5_WINE_PREFIX=~/.wine
MT5_TERMINAL_PATH=

# ===========================================================================
# brapi.dev — fundamentos / dividendos do Inspetor (ADR-014)
# ===========================================================================
# Token da API. Os indicadores fundamentalistas (ROE, P/VP, etc.) ficam nos
# módulos defaultKeyStatistics/financialData e exigem plano PRO.
BRAPI_TOKEN=
BRAPI_BASE_URL=https://brapi.dev/api

