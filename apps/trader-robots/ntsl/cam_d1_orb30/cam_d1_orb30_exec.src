//------------------------------------------------------------------//
//  cam_d1_orb30_exec.src  —  Profit (NTSL / Nelogica)               //
//  Estrategia D1 "ORB-30" — EXECUTOR (replica do EA MQL5)           //
//                                                                    //
//  =====================  O QUE E ESTE ROBO  =====================   //
//  Replica em NTSL (Profit) do cam_d1_orb30_exec.mq5 (MetaTrader) e  //
//  do d1_orb30.py (CAM). Faz parte da VALIDACAO TRIPLA: o mesmo robo //
//  roda em Profit x MetaTrader x CAM e os resultados devem convergir //
//  (ver project/trader-robots/POLITICA-ROBOS.md).                    //
//                                                                    //
//  ====================  A ESTRATEGIA (ORB-30)  ==================   //
//  1) Mede o range de abertura (max/min entre AberturaHHMM e         //
//     FimORHHMM — ex.: 09:00 ate 09:30).                             //
//  2) Entra A MERCADO na quebra A FAVOR DA TENDENCIA: compra se      //
//     Close rompe o topo do range; vende se rompe o fundo. So a      //
//     favor da tendencia das ultimas FiltroTendBarras barras.        //
//  3) Stop inicial + STOP MOVEL (trailing) que segue o pico; alvo    //
//     fixo opcional; 1 trade por direcao/dia; zera no fim do pregao. //
//                                                                    //
//  =========================  ATENCAO  =========================     //
//  >> Time e comparado em HHMM (ex.: 930 = 09:30, 1755 = 17:55). Se  //
//     a sua versao do Profit usar outro formato de hora, ajuste os   //
//     parametros *HHMM. NTSL nao foi compilado aqui — verifique no   //
//     editor do Profit (nomes de funcoes de ordem podem variar). <<  //
//  Use os MESMOS parametros do MT5/CAM para a paridade (ex.: stop    //
//  700, trail 800, tendencia 5000). Conta DEMO ate status TESTE.     //
//------------------------------------------------------------------//

input
  Contratos(1);            // quantidade de contratos por ordem
  AberturaHHMM(900);       // inicio do pregao / do range (HHMM, ex.: 900 = 09:00)
  FimORHHMM(930);          // fim do range de abertura (HHMM, ex.: 930 = 09:30)
  EntradaAteHHMM(1700);    // nao abre nova posicao apos (HHMM)
  FechamentoHHMM(1755);    // flat compulsorio a partir de (HHMM)
  StopInicialPts(700);     // stop inicial, em pontos
  AlvoFixoPts(0);          // alvo fixo (take), em pontos; 0 = sem alvo
  StopMovelPts(800);       // stop movel (trailing), em pontos; 0 = off
  FiltroTendBarras(5000);  // so a favor da tendencia de N barras; 0 = off

var
  orHigh    : Float;
  orLow     : Float;
  maxFavor  : Float;
  stopPrice : Float;
  rng       : Float;
  curDate   : Float;
  orReady   : Boolean;
  longArmed : Boolean;
  shortArmed: Boolean;
  tendUp    : Boolean;
  tendDown  : Boolean;

begin
  // --- novo pregao -> reseta estado ---
  if (Date <> curDate) then
  begin
    curDate    := Date;
    orReady    := False;
    longArmed  := True;
    shortArmed := True;
  end;

  // --- flat compulsorio no fim da sessao (sem overnight) ---
  if (Time >= FechamentoHHMM) then
  begin
    if (Position <> 0) then
      ClosePosition;
  end
  else
  begin
    // --- construcao do range de abertura ---
    if (Time >= AberturaHHMM) and (Time < FimORHHMM) then
    begin
      if (not orReady) then
      begin
        orHigh  := High;
        orLow   := Low;
        orReady := True;
      end
      else
      begin
        if (High > orHigh) then orHigh := High;
        if (Low  < orLow)  then orLow  := Low;
      end;
    end
    // --- janela de entrada (apos o range, antes do corte) ---
    else if (orReady) and (Time < EntradaAteHHMM) then
    begin
      rng := orHigh - orLow;

      // ------------------- GESTAO DE POSICAO ABERTA -------------------
      if (Position > 0) then
      begin
        // stop movel da COMPRA: segue a maxima; o stop so sobe.
        if (High > maxFavor) then maxFavor := High;
        if (StopMovelPts > 0) and (maxFavor - StopMovelPts > stopPrice) then
          stopPrice := maxFavor - StopMovelPts;
        SellToCoverStop(stopPrice);                 // stop de protecao (long)
      end
      else if (Position < 0) then
      begin
        // stop movel da VENDA: segue a minima; o stop so desce.
        if (Low < maxFavor) then maxFavor := Low;
        if (StopMovelPts > 0) and (maxFavor + StopMovelPts < stopPrice) then
          stopPrice := maxFavor + StopMovelPts;
        BuyToCoverStop(stopPrice);                  // stop de protecao (short)
      end
      // ------------------------- ENTRADAS -----------------------------
      else if (rng > 0) then
      begin
        // Filtro de tendencia: so aplica quando ha historico suficiente
        // (CurrentBar > N). Sem historico -> LIBERA (fail-open), para nao
        // travar o teste numa janela curta. Com FiltroTendBarras=0 -> off.
        tendUp   := True;
        tendDown := True;
        if (FiltroTendBarras > 0) and (CurrentBar > FiltroTendBarras) then
        begin
          tendUp   := Close > Close[FiltroTendBarras];
          tendDown := Close < Close[FiltroTendBarras];
        end;

        // COMPRA na quebra do topo, a favor da tendencia
        if (longArmed) and (Close > orHigh) and (tendUp) then
        begin
          longArmed := False;
          BuyAtMarket(Contratos);
          maxFavor  := Close;
          stopPrice := Close - StopInicialPts;
          SellToCoverStop(stopPrice);
          if (AlvoFixoPts > 0) then
            SellToCoverLimit(Close + AlvoFixoPts);
        end
        // VENDA na quebra do fundo, a favor da tendencia
        else if (shortArmed) and (Close < orLow) and (tendDown) then
        begin
          shortArmed := False;
          SellShortAtMarket(Contratos);
          maxFavor  := Close;
          stopPrice := Close + StopInicialPts;
          BuyToCoverStop(stopPrice);
          if (AlvoFixoPts > 0) then
            BuyToCoverLimit(Close - AlvoFixoPts);
        end;
      end;
    end;
  end;
end;
