//------------------------------------------------------------------//
//  cam_d1_orb30_exec.src  —  Profit (NTSL / Nelogica)               //
//  Estrategia D1 "ORB-30" — EXECUTOR (replica do EA MQL5)           //
//                                                                    //
//  Replica em NTSL do cam_d1_orb30_exec.mq5 (MetaTrader) e do        //
//  d1_orb30.py (CAM) — VALIDACAO TRIPLA (ver POLITICA-ROBOS.md).     //
//                                                                    //
//  ====================  A ESTRATEGIA (ORB-30)  ==================   //
//  1) Range de abertura = max/min entre AberturaHHMM e FimORHHMM     //
//     (ex.: 09:00 a 09:30).                                          //
//  2) Entra A MERCADO na quebra A FAVOR DA TENDENCIA (compra acima   //
//     do topo / vende abaixo do fundo do range). 1 trade/direcao/dia.//
//  3) Stop inicial + STOP MOVEL (trailing) + alvo fixo opcional;     //
//     flat no fim do pregao.                                         //
//                                                                    //
//  ====================  GESTAO DE SAIDA (NTSL)  =================   //
//  A gestao de posicao roda em TODA barra (nao so na janela de       //
//  entrada). A saida e DETERMINISTICA: quando a barra fura o stop    //
//  (Low<=stop na compra / High>=stop na venda) OU no fim do pregao,  //
//  zera A MERCADO. Isso garante que a posicao SEMPRE fecha (sem      //
//  drawdown de posicao correndo solta).                             //
//                                                                    //
//  ===================  MAPA NTSL <-> MetaTrader  ===============   //
//   AberturaHHMM/FimORHHMM .. InpOR_Minutos (30 min = 900..930)      //
//   StopInicialPts ......... InpStopInicial_Pts                      //
//   AlvoFixoPts ............ InpAlvoFixo_Pts                         //
//   StopMovelPts ........... InpStopMovel_Pts                        //
//   FiltroTendBarras ....... InpFiltroTendencia_Barras               //
//   Contratos .............. InpContratos                            //
//  Use os MESMOS valores do MT5/CAM. Conta DEMO ate status TESTE.    //
//------------------------------------------------------------------//

input
  Contratos(1);            // quantidade de contratos por ordem
  AberturaHHMM(900);       // inicio do pregao / do range (HHMM)
  FimORHHMM(930);          // fim do range de abertura (HHMM)
  EntradaAteHHMM(1700);    // nao abre nova posicao apos (HHMM)
  FechamentoHHMM(1755);    // flat compulsorio a partir de (HHMM)
  StopInicialPts(700);     // stop inicial, em pontos
  AlvoFixoPts(0);          // alvo fixo (take), em pontos; 0 = sem alvo
  StopMovelPts(800);       // stop movel (trailing), em pontos; 0 = off
  FiltroTendBarras(5000);  // so a favor da tendencia de N barras; 0 = off

var
  orHigh    : Float;
  orLow     : Float;
  maxFavor  : Float;
  stopPrice : Float;
  alvoPrice : Float;
  rng       : Float;
  curDate   : Float;
  orReady   : Boolean;
  longArmed : Boolean;
  shortArmed: Boolean;
  tendUp    : Boolean;
  tendDown  : Boolean;

begin
  // ============== RESET DIARIO (novo pregao) ==============
  if (Date <> curDate) then
  begin
    curDate    := Date;
    orReady    := False;
    longArmed  := True;
    shortArmed := True;
  end;

  // ============== GESTAO DE POSICAO (TODA barra) ==============
  // Saida por STOP PENDENTE no preco (SellToCoverStop/BuyToCoverStop) -> preenche
  // NO PRECO DO STOP, igual ao MT5. Re-emitido todo bar (atualiza/trail). Flat no
  // fim do pregao a mercado. (Sair a mercado no toque do stop preenche na abertura
  // da proxima barra, abaixo do stop -> infla a perda; por isso usamos stop.)
  if (IsBought) then
  begin
    if (High > maxFavor) then maxFavor := High;
    if (StopMovelPts > 0) and (maxFavor - StopMovelPts > stopPrice) then
      stopPrice := maxFavor - StopMovelPts;

    if (Time >= FechamentoHHMM) then
      SellToCoverAtMarket                             // flat no fim do pregao
    else
    begin
      SellToCoverStop(stopPrice);                     // stop no preco (long)
      if (AlvoFixoPts > 0) then
        SellToCoverLimit(alvoPrice);                  // alvo (opcional)
    end;
  end
  else if (IsSold) then
  begin
    if (Low < maxFavor) then maxFavor := Low;
    if (StopMovelPts > 0) and (maxFavor + StopMovelPts < stopPrice) then
      stopPrice := maxFavor + StopMovelPts;

    if (Time >= FechamentoHHMM) then
      BuyToCoverAtMarket                              // flat no fim do pregao
    else
    begin
      BuyToCoverStop(stopPrice);                      // stop no preco (short)
      if (AlvoFixoPts > 0) then
        BuyToCoverLimit(alvoPrice);
    end;
  end
  // ============== FLAT -> range de abertura + entradas ==============
  else if (Time < FechamentoHHMM) then
  begin
    // --- construcao do range de abertura ---
    if (Time >= AberturaHHMM) and (Time < FimORHHMM) then
    begin
      if (not orReady) then
      begin
        orHigh  := High;
        orLow   := Low;
        orReady := True;
      end
      else
      begin
        if (High > orHigh) then orHigh := High;
        if (Low  < orLow)  then orLow  := Low;
      end;
    end
    // --- janela de entrada (apos o range, antes do corte) ---
    else if (orReady) and (Time >= FimORHHMM) and (Time < EntradaAteHHMM) then
    begin
      rng := orHigh - orLow;
      if (rng > 0) then
      begin
        // filtro de tendencia: so aplica com historico suficiente (fail-open)
        tendUp   := True;
        tendDown := True;
        if (FiltroTendBarras > 0) and (CurrentBar > FiltroTendBarras) then
        begin
          tendUp   := Close > Close[FiltroTendBarras];
          tendDown := Close < Close[FiltroTendBarras];
        end;

        // COMPRA na quebra do topo, a favor da tendencia
        if (longArmed) and (Close > orHigh) and (tendUp) then
        begin
          longArmed := False;
          BuyAtMarket(Contratos);
          maxFavor  := Close;
          stopPrice := Close - StopInicialPts;
          if (AlvoFixoPts > 0) then alvoPrice := Close + AlvoFixoPts;
        end
        // VENDA na quebra do fundo, a favor da tendencia
        else if (shortArmed) and (Close < orLow) and (tendDown) then
        begin
          shortArmed := False;
          SellShortAtMarket(Contratos);
          maxFavor  := Close;
          stopPrice := Close + StopInicialPts;
          if (AlvoFixoPts > 0) then alvoPrice := Close - AlvoFixoPts;
        end;
      end;
    end;
  end;
end;
